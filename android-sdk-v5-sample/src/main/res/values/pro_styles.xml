<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="pro_theme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/pro_background</item>
        <item name="android:colorAccent">@color/pro_primary</item>
        <item name="colorAccent">@color/pro_primary</item>
        <item name="android:statusBarColor">@color/pro_background</item>
        <item name="android:navigationBarColor">@color/pro_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="pro_title">
        <item name="android:textColor">@color/pro_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="pro_section">
        <item name="android:textColor">@color/pro_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="pro_body">
        <item name="android:textColor">@color/pro_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="pro_caption">
        <item name="android:textColor">@color/pro_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="pro_button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/pro_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/pro_primary</item>
    </style>

    <style name="pro_button_secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/pro_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/pro_surface_alt</item>
    </style>

    <style name="pro_input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/pro_input_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/pro_text</item>
        <item name="android:textColorHint">@color/pro_text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
