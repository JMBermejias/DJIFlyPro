<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_title"
            style="@style/pro_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cartography_subtitle"
            style="@style/pro_caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_camera"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_camera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <TextView
            android:id="@+id/text_camera_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_card_background"
            android:padding="12dp"
            style="@style/pro_caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_resolution_overlap"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_gsd"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_gsd"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_forward_overlap"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_forward"
            android:inputType="number" />

        <EditText
            android:id="@+id/edit_side_overlap"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_side"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_reference_block"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_altitude_reference"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/check_terrain_following"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/cartography_terrain_following"
            android:textColor="@color/pro_text" />

        <CheckBox
            android:id="@+id/check_cross_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/cartography_cross_track"
            android:textColor="@color/pro_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_area"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_area_length"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_length"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_area_width"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_width"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_area_latitude"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_latitude"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_area_longitude"
            style="@style/pro_input"
            android:hint="@string/cartography_hint_longitude"
            android:inputType="numberDecimal|numberSigned" />

        <Button
            android:id="@+id/button_calculate"
            style="@style/pro_button"
            android:text="@string/cartography_calculate" />

        <TextView
            android:id="@+id/text_solution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="@string/cartography_intro"
            style="@style/pro_body" />

        <Button
            android:id="@+id/button_apply_to_planner"
            style="@style/pro_button"
            android:enabled="false"
            android:text="@string/cartography_apply" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_control_section"
            style="@style/pro_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cartography_control_intro"
            style="@style/pro_caption" />

        <Button
            android:id="@+id/button_add_control_point"
            style="@style/pro_button_secondary"
            android:text="@string/cartography_add_control" />

        <Button
            android:id="@+id/button_pick_control_point"
            style="@style/pro_button_secondary"
            android:text="@string/cartography_pick_control" />

        <TextView
            android:id="@+id/text_control_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="@string/cartography_no_control"
            style="@style/pro_body" />

        <LinearLayout
            android:id="@+id/layout_control_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cartography_delivery"
            style="@style/pro_section" />

        <Button
            android:id="@+id/button_export_geojson"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/cartography_export_geojson" />

        <Button
            android:id="@+id/button_export_kml"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/cartography_export_kml" />

        <Button
            android:id="@+id/button_export_report"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/cartography_export_report" />

        <Button
            android:id="@+id/button_open_map"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/cartography_open_map" />

        <ProgressBar
            android:id="@+id/progress_cartography"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
