<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cartografía"
            style="@style/pro_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Define la resolución dellevantada y el solape. La altura de vuelo y las separaciones se calculan a partir del sensor y del objetivo, no al revés."
            style="@style/pro_caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cámara"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_camera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <TextView
            android:id="@+id/text_camera_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_card_background"
            android:padding="12dp"
            style="@style/pro_caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolución y solape"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_gsd"
            style="@style/pro_input"
            android:hint="Resolución objetivo (cm/px, por ejemplo 2)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_forward_overlap"
            style="@style/pro_input"
            android:hint="Solape longitudinal (%)"
            android:inputType="number" />

        <EditText
            android:id="@+id/edit_side_overlap"
            style="@style/pro_input"
            android:hint="Solape transversal (%)"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Referencia de altura y bloque"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_altitude_reference"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/check_terrain_following"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Seguir el terreno"
            android:textColor="@color/pro_text" />

        <CheckBox
            android:id="@+id/check_cross_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Pasada cruzada (bloque en perpendicular)"
            android:textColor="@color/pro_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parcela que se quiere cubrir"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_area_length"
            style="@style/pro_input"
            android:hint="Longitud de la parcela (m)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_area_width"
            style="@style/pro_input"
            android:hint="Ancho de la parcela (m)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_area_latitude"
            style="@style/pro_input"
            android:hint="Latitud del centro (WGS84)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_area_longitude"
            style="@style/pro_input"
            android:hint="Longitud del centro (WGS84)"
            android:inputType="numberDecimal|numberSigned" />

        <Button
            android:id="@+id/button_calculate"
            style="@style/pro_button"
            android:text="Calcular parameters" />

        <TextView
            android:id="@+id/text_solution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="Introduce la resolución, el solape y la parcela para calcular los parámetros de vuelo."
            style="@style/pro_body" />

        <Button
            android:id="@+id/button_apply_to_planner"
            style="@style/pro_button"
            android:enabled="false"
            android:text="Aplicar al planificador" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntos de control"
            style="@style/pro_section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Un bloque sin control no se puede georreferenciar. Mínimo 4 puntos de control y 1 de verificación, repartidos por los bordes."
            style="@style/pro_caption" />

        <Button
            android:id="@+id/button_add_control_point"
            style="@style/pro_button_secondary"
            android:text="Añadir punto de control" />

        <Button
            android:id="@+id/button_pick_control_point"
            style="@style/pro_button_secondary"
            android:text="Elegir punto en el mapa" />

        <TextView
            android:id="@+id/text_control_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="Sin puntos de control."
            style="@style/pro_body" />

        <LinearLayout
            android:id="@+id/layout_control_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrega"
            style="@style/pro_section" />

        <Button
            android:id="@+id/button_export_geojson"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="Exportar GeoJSON" />

        <Button
            android:id="@+id/button_export_kml"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="Exportar KML" />

        <Button
            android:id="@+id/button_export_report"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="Exportar ficha de vuelo (JSON)" />

        <Button
            android:id="@+id/button_open_map"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="Ver en el mapa" />

        <ProgressBar
            android:id="@+id/progress_cartography"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
