<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/pro_card_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/algorithm_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/algorithm_card_title"
        style="@style/pro_body" />

    <TextView
        android:id="@+id/algorithm_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/pro_caption" />

    <TextView
        android:id="@+id/algorithm_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/pro_caption" />

    <Button
        android:id="@+id/algorithm_use"
        style="@style/pro_button_secondary"
        android:text="@string/algorithm_card_use" />
</LinearLayout>
