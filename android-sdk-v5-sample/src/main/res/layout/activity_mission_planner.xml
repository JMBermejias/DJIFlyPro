<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_title"
            style="@style/pro_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/planner_subtitle"
            style="@style/pro_caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_work_type"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_template"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_block_center"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_latitude"
            style="@style/pro_input"
            android:hint="@string/planner_hint_latitude"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_longitude"
            style="@style/pro_input"
            android:hint="@string/planner_hint_longitude"
            android:inputType="numberDecimal|numberSigned" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_geometry_capture"
            style="@style/pro_section" />

        <EditText
            android:id="@+id/edit_length"
            style="@style/pro_input"
            android:hint="@string/planner_hint_length"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_width"
            style="@style/pro_input"
            android:hint="@string/planner_hint_width"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_height"
            style="@style/pro_input"
            android:hint="@string/planner_hint_height"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_bearing"
            style="@style/pro_input"
            android:hint="@string/planner_hint_bearing"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_altitude"
            style="@style/pro_input"
            android:hint="@string/planner_hint_altitude"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_standoff"
            style="@style/pro_input"
            android:hint="@string/planner_hint_standoff"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_line_spacing"
            style="@style/pro_input"
            android:hint="@string/planner_hint_line_spacing"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_photo_spacing"
            style="@style/pro_input"
            android:hint="@string/planner_hint_photo_spacing"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_overlap"
            style="@style/pro_input"
            android:hint="@string/planner_hint_overlap"
            android:inputType="number" />

        <EditText
            android:id="@+id/edit_speed"
            style="@style/pro_input"
            android:hint="@string/planner_hint_speed"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/spinner_route_pattern"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <Spinner
            android:id="@+id/spinner_finish_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <Button
            android:id="@+id/button_cartography"
            style="@style/pro_button_secondary"
            android:text="@string/planner_cartography_button" />

        <Button
            android:id="@+id/button_open_map"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_open_map" />

        <Button
            android:id="@+id/button_pick_control_point"
            style="@style/pro_button_secondary"
            android:text="@string/planner_pick_control" />

        <EditText
            android:id="@+id/edit_mission_name"
            style="@style/pro_input"
            android:hint="@string/planner_hint_name"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/button_generate_mission"
            style="@style/pro_button"
            android:text="@string/planner_generate" />

        <TextView
            android:id="@+id/text_capability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pro_warning_background"
            android:padding="12dp"
            android:text="@string/planner_checking_compatibility"
            style="@style/pro_caption" />

        <TextView
            android:id="@+id/text_plan_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="@string/planner_no_route"
            style="@style/pro_body" />

        <TextView
            android:id="@+id/text_cartographic_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pro_card_background"
            android:padding="14dp"
            android:text="@string/planner_no_profile"
            style="@style/pro_body" />

        <TextView
            android:id="@+id/text_plan_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            style="@style/pro_caption" />

        <ProgressBar
            android:id="@+id/progress_mission"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_export_json"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_export_json" />

        <Button
            android:id="@+id/button_export_kmz"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_export_kmz" />

        <Button
            android:id="@+id/button_export_geojson"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_export_geojson" />

        <Button
            android:id="@+id/button_export_kml"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_export_kml" />

        <Button
            android:id="@+id/button_export_report"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_export_report" />

        <Button
            android:id="@+id/button_export_validation_report"
            style="@style/pro_button_secondary"
            android:text="@string/planner_export_validation" />

        <Button
            android:id="@+id/button_upload_mission"
            style="@style/pro_button"
            android:enabled="false"
            android:text="@string/planner_upload" />

        <Button
            android:id="@+id/button_start_mission"
            style="@style/pro_button"
            android:enabled="false"
            android:text="@string/planner_start" />

        <Button
            android:id="@+id/button_pause_mission"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_pause" />

        <Button
            android:id="@+id/button_stop_mission"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/planner_stop" />

        <Button
            android:id="@+id/button_manual_guidance"
            style="@style/pro_button"
            android:enabled="false"
            android:text="@string/planner_manual_guidance" />
    </LinearLayout>
</ScrollView>
