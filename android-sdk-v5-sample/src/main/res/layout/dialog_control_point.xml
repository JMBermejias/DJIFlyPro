<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pro_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gcp_dialog_title"
            style="@style/pro_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gcp_dialog_subtitle"
            style="@style/pro_caption" />

        <EditText
            android:id="@+id/edit_gcp_code"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_code"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/edit_gcp_latitude"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_latitude"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_gcp_longitude"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_longitude"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_gcp_height"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_height"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edit_gcp_accuracy"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_accuracy"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_gcp_source"
            style="@style/pro_input"
            android:hint="@string/gcp_hint_source"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gcp_target_type"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_gcp_target"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gcp_role"
            style="@style/pro_section" />

        <Spinner
            android:id="@+id/spinner_gcp_role"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/pro_input_background"
            android:padding="8dp" />

        <Button
            android:id="@+id/button_save_control_point"
            style="@style/pro_button"
            android:text="@string/gcp_save" />
    </LinearLayout>
</ScrollView>
