<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_background">

    <dji.v5.ux.map.MapWidget
        android:id="@+id/map_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/panel_map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/panel_map"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/pro_surface"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/text_map_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_loading"
            style="@style/pro_title" />

        <TextView
            android:id="@+id/text_map_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/pro_caption" />

        <TextView
            android:id="@+id/text_map_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pro_warning_background"
            android:padding="10dp"
            android:text="@string/map_support_notice"
            style="@style/pro_caption" />

        <Button
            android:id="@+id/button_pick_here"
            style="@style/pro_button"
            android:enabled="false"
            android:text="@string/map_use_centre" />

        <Button
            android:id="@+id/button_center_block"
            style="@style/pro_button_secondary"
            android:enabled="false"
            android:text="@string/map_centre_block" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
