<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/pro_card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/text_control_point_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pro_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/text_control_point_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/pro_text_secondary"
        android:textSize="12sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_edit_control_point"
            style="@style/pro_button_secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="Editar"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/button_delete_control_point"
            style="@style/pro_button_secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="Eliminar"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
